{
  "name": "backend",
  "version": "1.0.0",
  "description": "MERN Backend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ai:data": "python ai/src/data_simulation.py --samples 5000 --output ai/data/simulated_tickets.csv",
    "ai:train": "python ai/src/train_model.py --dataset ai/data/simulated_tickets.csv --model-out ai/model/ticket_rf.joblib",
    "ai:example": "python ai/src/example_usage.py"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.5",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
